{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Database": {
    "Note": "Prefer backend/.env: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD"
  },
  "Cache": {
    "UseInMemory": false
  },
  "Jwt": {
    "Secret": "SchoolCom-Super-Secret-Key-Min-32-Chars-Long!",
    "Issuer": "SchoolCom",
    "Audience": "SchoolComClients",
    "AccessTokenMinutes": "60"
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "WhatsApp": {
    "DevMode": true,
    "DevPhoneNumberId": "dev-phone-id",
    "WebhookVerifyToken": "schoolcom-webhook-token",
    "ApiBaseUrl": "https://graph.facebook.com/v21.0"
  }
}
